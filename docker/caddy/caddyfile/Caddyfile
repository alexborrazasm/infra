{
	auto_https disable_redirects
}

(remove-headers) {
	header -Via
	header -X-Powered-By
	header -X-Generator
	header -X-AspNet-Version
	header -X-AspNetMvc-Version
	header -X-Runtime
	header >Server "EXAMPLE"

	handle_errors {
		header Server "EXAMPLE"
	}
}

# Manual redirect to remove caddy headers
http:// {
	import remove-headers
	redir https://{host}{uri} permanent
}

example.com {
	import remove-headers
	log {
		output file /log/example.com.log
	}

	respond "SOMETHING"
}

*.example.com {
	import remove-headers
	log {
		output file /log/wildcard.example.com.log
	}

	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@sub1 host app.example.com
	handle @sub1 {
		respond "HELLO"
	}

	@proxy host proxy.example.com
	handle @proxy {
		reverse_proxy * http://service:8080
	}

	handle {
		abort
	}
}

# Tailnet-only services. Container port 8443 is reached only through the tailnet IP (see
# compose.yaml) and *.pri.example.com is a wildcard DNS record (DNS only) at the tailnet IP,
# so nothing here is reachable from the internet.
*.pri.example.com:8443 {
	import remove-headers
	log {
		output file /log/pri.example.com.log
	}

	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	@dns host dns.pri.example.com
	handle @dns {
		reverse_proxy http://host.docker.internal:3080
	}

	handle {
		abort
	}
}
