# Public URL of the Headscale server
TS_LOGIN_SERVER=https://ts.example.com

# Pre-auth key, only needed to join a new node
TS_AUTHKEY=

# Password of the restic repository. Keep a copy in your password manager.
RESTIC_PASSWORD=

# Telegram bot for notifications (backup failures, low disk space)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
