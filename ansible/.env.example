# Public URL of the Headscale server
TS_LOGIN_SERVER=https://ts.example.com

# Pre-auth key, only needed to join a new node
TS_AUTHKEY=

# Restic repository password of each host. The variable name is chosen per host
# in inventory/host_vars/<host>.yml (backup_password_env). No shared default.
# Keep a copy in your password manager.
RESTIC_PASSWORD_CLOUD=

# Telegram bot for notifications (backup failures, low disk space)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
