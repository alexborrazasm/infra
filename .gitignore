.venv/
*.retry
pki/
docker/*/.*.env
# Runtime dirs: keep the (empty) folder via .gitkeep, ignore the contents
docker/*/data/*
!docker/*/data/.gitkeep
docker/*/config/*
!docker/*/config/.gitkeep
docker/*/log/*
!docker/*/log/.gitkeep
docker/*/srv/*
!docker/*/srv/.gitkeep
docker/*/vw-data/*
!docker/*/vw-data/.gitkeep
docker/*/certificates/*
!docker/*/certificates/.gitkeep
docker/headscale/back/config/*
!docker/headscale/back/config/.gitkeep
docker/headscale/back/data/lib/*
!docker/headscale/back/data/lib/.gitkeep
docker/headscale/back/data/run/*
!docker/headscale/back/data/run/.gitkeep
docker/headscale/front/config/*
!docker/headscale/front/config/.gitkeep
docker/headscale/front/data/*
!docker/headscale/front/data/.gitkeep
!docker/headscale/front/config/config.example.yaml
!docker/headscale/back/config/config.example.yaml
ansible/.env
